# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string. Local example:
# postgresql://postgres:yourpassword@localhost:5432/expense_splitter
# Render/Supabase give you this string directly on the database's dashboard.
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_splitter

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the API listens on locally. Render sets this automatically in production.
PORT=4000

NODE_ENV=development

# Optional: only needed for the "email invites" feature.
# Without this, invites still work — the invite link just gets printed
# to the server's console instead of emailed. Get a free key at resend.com.
RESEND_API_KEY=
INVITE_FROM_EMAIL=Split <onboarding@resend.dev>
CLIENT_APP_URL=http://localhost:5173
